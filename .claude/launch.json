{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "review"
      ],
      "port": 8765
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "apollo.api.main",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "api-sandbox",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "apollo.api.main",
        "--port",
        "8000",
        "--web-port",
        "5174",
        "--root",
        ".superpowers/sandbox"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "web-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174,
      "url": "http://localhost:5174"
    },
    {
      "name": "api-review",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "apollo.api.main",
        "--port",
        "8001",
        "--web-port",
        "5176",
        "--root",
        ".superpowers/sandbox"
      ],
      "port": 8001,
      "url": "http://127.0.0.1:8001"
    },
    {
      "name": "web-review",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API=http://127.0.0.1:8001",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5176"
      ],
      "port": 5176,
      "url": "http://localhost:5176"
    }
  ]
}
