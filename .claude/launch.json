{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "review"],
      "port": 8765
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "apollo.api.main", "--port", "8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
